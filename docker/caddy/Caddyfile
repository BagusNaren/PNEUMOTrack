# Local API gateway for the self-hosted Supabase stack.
# Public API surface stays compatible with the Supabase CLI defaults
# (http://127.0.0.1:54321/auth/v1, /rest/v1).
:8000 {
	handle /health {
		respond "ok" 200
	}

	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	handle_path /rest/v1 {
		reverse_proxy rest:3000
	}

	respond 404
}
